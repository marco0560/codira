{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codira.local/schema/capabilities.schema.json",
  "title": "codira capability contract",
  "type": "object",
  "required": [
    "schema_version",
    "ontology",
    "commands",
    "channels",
    "retrieval_capabilities",
    "retrieval_producers",
    "plugin_families",
    "plugins",
    "mcp",
    "query_daemon",
    "python_target",
    "analyzers",
    "validation"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "ontology": {
      "type": "object",
      "required": ["version", "types"],
      "properties": {
        "version": { "type": "string" },
        "types": {
          "type": "array",
          "items": {
            "enum": [
              "module",
              "type",
              "callable",
              "import",
              "constant",
              "variable",
              "namespace",
              "documentation"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["intent", "channels", "guarantee", "limitations"],
        "properties": {
          "intent": { "type": "string" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "channels": {
            "type": "array",
            "items": {
              "enum": [
                "call_graph",
                "doc_issues",
                "docs",
                "embedding",
                "references",
                "semantic",
                "symbol"
              ]
            },
            "uniqueItems": true
          },
          "guarantee": { "type": "string" },
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "subcommands": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["intent", "modes", "options", "guarantee"],
              "properties": {
                "intent": { "type": "string" },
                "modes": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                },
                "options": {
                  "type": "array",
                  "items": { "type": "string" },
                  "uniqueItems": true
                },
                "guarantee": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "object",
      "required": [
        "call_graph",
        "doc_issues",
        "docs",
        "embedding",
        "references",
        "semantic",
        "symbol"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["match", "source", "guarantee"],
        "properties": {
          "match": { "type": "string" },
          "source": { "type": "string" },
          "guarantee": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "retrieval_capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "retrieval_producers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "plugin_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "selection", "configuration", "role"],
        "properties": {
          "family": {
            "enum": [
              "analyzer",
              "backend",
              "embedding",
              "vector-store",
              "similarity-index",
              "documentation-audit"
            ]
          },
          "selection": {
            "enum": ["multiple_active", "single_active", "route_active"]
          },
          "configuration": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family",
          "name",
          "active",
          "provider",
          "origin",
          "source",
          "status",
          "version",
          "distribution_version",
          "entry_point",
          "detail"
        ],
        "properties": {
          "family": {
            "enum": [
              "analyzer",
              "backend",
              "embedding",
              "vector-store",
              "similarity-index",
              "documentation-audit"
            ]
          },
          "name": { "type": "string", "minLength": 1 },
          "active": { "type": "boolean" },
          "provider": { "type": "string", "minLength": 1 },
          "origin": {
            "enum": ["core", "first_party", "third_party"]
          },
          "source": {
            "enum": ["builtin", "entry_point"]
          },
          "status": {
            "enum": ["loaded", "skipped", "duplicate"]
          },
          "version": { "type": "string", "minLength": 1 },
          "distribution_version": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "entry_point": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "detail": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          }
        },
        "additionalProperties": false
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "server_command",
        "config_command",
        "contract_version",
        "transport",
        "read_only",
        "tools"
      ],
      "properties": {
        "server_command": { "const": "codira-mcp" },
        "config_command": { "const": "codira-mcp-config" },
        "contract_version": { "type": "string" },
        "transport": { "const": "stdio" },
        "read_only": { "const": true },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "query_daemon": {
      "type": "object",
      "required": ["supported", "enabled", "lifecycle_commands", "repository_scope", "mutation_policy"],
      "properties": {
        "supported": { "const": true },
        "enabled": { "type": "boolean" },
        "lifecycle_commands": {
          "type": "array",
          "items": { "enum": ["run", "install", "uninstall", "start", "stop", "status"] },
          "uniqueItems": true,
          "minItems": 6,
          "maxItems": 6
        },
        "repository_scope": { "type": "string", "minLength": 1 },
        "mutation_policy": { "const": "read_only; indexing daemon remains the automatic writer" }
      },
      "additionalProperties": false
    },
    "python_target": {
      "type": "object",
      "required": ["source", "specifier", "outcome", "supported_minors", "tested_minors", "grammar", "host_python", "parser_compatibility", "detail", "feature_rules", "provenance"],
      "properties": {
        "source": { "enum": ["override", "pyproject", "none"] },
        "specifier": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "outcome": { "enum": ["override", "detected", "invalid", "unknown", "partial", "unsupported"] },
        "supported_minors": { "type": "array", "items": { "pattern": "^3\\.[0-9]+$" }, "uniqueItems": true },
        "tested_minors": { "type": "array", "items": { "pattern": "^3\\.[0-9]+$" }, "uniqueItems": true },
        "grammar": {
          "type": "object",
          "required": ["identity", "maximum_target_minor"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "maximum_target_minor": { "pattern": "^3\\.[0-9]+$" }
          },
          "additionalProperties": false
        },
        "host_python": { "pattern": "^3\\.[0-9]+$" },
        "parser_compatibility": { "const": "plugin_owned_tree_sitter" },
        "detail": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "feature_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "minimum_version"],
            "properties": {
              "feature": { "type": "string", "minLength": 1 },
              "minimum_version": { "pattern": "^3\\.[0-9]+$" }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "required": ["source", "key"],
          "properties": {
            "source": { "enum": ["override", "pyproject", "none"] },
            "key": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "analyzers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "analyzer_name",
          "analyzer_version",
          "source",
          "entrypoint",
          "declaration_status",
          "supports",
          "does_not_support",
          "mappings",
          "checksum",
          "default_coverage_roots",
          "concurrency"
        ],
        "properties": {
          "analyzer_name": { "type": "string", "minLength": 1 },
          "analyzer_version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "entrypoint": { "type": "string", "minLength": 1 },
          "declaration_status": {
            "enum": ["declared", "missing", "invalid"]
          },
          "supports": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "does_not_support": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "mappings": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "checksum": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "default_coverage_roots": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "target_compatibility": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["language", "configuration_key", "metadata_key", "declared_minors", "parser_compatibility"],
                "properties": {
                  "language": { "const": "python" },
                  "configuration_key": { "const": "plugins.analyzer-python.target_python" },
                  "metadata_key": { "const": "project.requires-python" },
                  "declared_minors": { "type": "array", "items": { "pattern": "^3\\.[0-9]+$" }, "uniqueItems": true },
                  "parser_compatibility": { "const": "plugin_owned_tree_sitter" }
                },
                "additionalProperties": false
              }
            ]
          },
          "concurrency": {
            "type": "object",
            "required": [
              "declaration_status",
              "process_workers",
              "thread_workers",
              "reentrant_after_configure",
              "notes"
            ],
            "properties": {
              "declaration_status": {
                "enum": ["declared", "missing", "invalid"]
              },
              "process_workers": { "type": "boolean" },
              "thread_workers": { "type": "boolean" },
              "reentrant_after_configure": { "type": "boolean" },
              "notes": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "issues"],
      "properties": {
        "status": { "enum": ["ok", "degraded"] },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

#!/bin/sh
# Prefer the frozen task profile placed beside the prebuilt workspace index.
profile=/opt/codira/benchmark-codira.toml
previous=
for argument in "$@"; do
    if test "$previous" = --root && test -f "$argument/.codira/config.toml"; then
        profile="$argument/.codira/config.toml"
    fi
    previous="$argument"
done
exec env CODIRA_CONFIG_FILE="$profile" codira-mcp "$@"

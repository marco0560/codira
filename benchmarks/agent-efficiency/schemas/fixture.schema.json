{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fixture_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "private_locator": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_url": {
      "format": "uri",
      "type": "string"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "schema_version",
    "fixture_id",
    "revision",
    "source_url",
    "license",
    "visibility"
  ],
  "type": "object"
}

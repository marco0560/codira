{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounting": {
      "additionalProperties": false,
      "properties": {
        "max_daily_spend_usd": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_estimated_attempt_spend_usd": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_estimated_pilot_spend_usd": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_response_requests_per_attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_tokens_scope": {
          "enum": [
            "whole-session",
            "per-continuation"
          ]
        },
        "max_transport_attempts_per_response": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_daily_spend_usd",
        "max_estimated_attempt_spend_usd",
        "max_estimated_pilot_spend_usd",
        "max_response_requests_per_attempt"
      ],
      "type": "object"
    },
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_total_tokens",
        "max_output_tokens",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "max_completion_usd_per_million": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "max_prompt_usd_per_million": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "const": "openrouter"
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "wire_api": {
          "const": "responses"
        }
      },
      "required": [
        "name",
        "model",
        "reasoning_effort",
        "wire_api",
        "max_prompt_usd_per_million",
        "max_completion_usd_per_million"
      ],
      "type": "object"
    },
    "resource_controls": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": "none"
        },
        "pids_limit": {
          "minimum": 1,
          "type": "integer"
        },
        "read_only_rootfs": {
          "const": true
        },
        "tmpfs_size_mib": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "network",
        "read_only_rootfs",
        "pids_limit",
        "tmpfs_size_mib"
      ],
      "type": "object"
    },
    "runtime_image": {
      "pattern": "^.+@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "stage": {
      "enum": [
        "calibration",
        "pilot"
      ]
    },
    "task_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "treatment_protocol": {
      "additionalProperties": false,
      "properties": {
        "agent_instruction": {
          "minLength": 1,
          "type": "string"
        },
        "codira_mcp_instruction": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "version",
        "codira_mcp_instruction"
      ],
      "type": "object"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "stage",
    "task_ids",
    "budgets",
    "provider",
    "accounting",
    "resource_controls",
    "visibility"
  ],
  "type": "object"
}

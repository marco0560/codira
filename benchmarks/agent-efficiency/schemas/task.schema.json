{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fixture_id": {
      "type": "string"
    },
    "oracle_id": {
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "type": "string"
    },
    "result_format": {
      "enum": [
        "json",
        "text",
        "workspace-diff"
      ]
    },
    "result_path": {
      "format": "safe-relative-path",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "fixture_id",
    "prompt",
    "result_path",
    "oracle_id",
    "visibility"
  ],
  "type": "object"
}

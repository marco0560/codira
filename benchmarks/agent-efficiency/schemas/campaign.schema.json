{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "accounting": {
            "properties": {
              "budget_reservation_mode": {
                "enum": [
                  "sum-attempt-ceilings",
                  "shared-pool"
                ]
              },
              "max_daily_spend_usd": {
                "exclusiveMinimum": 0
              },
              "max_estimated_attempt_spend_usd": {
                "exclusiveMinimum": 0
              },
              "max_estimated_pilot_spend_usd": {
                "exclusiveMinimum": 0
              }
            }
          },
          "provider": {
            "properties": {
              "max_completion_usd_per_million": {
                "exclusiveMinimum": 0
              },
              "max_prompt_usd_per_million": {
                "exclusiveMinimum": 0
              },
              "name": {
                "const": "openrouter"
              },
              "wire_api": {
                "const": "responses"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "provider": {
            "properties": {
              "name": {
                "const": "codex-subscription"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "accounting": {
            "properties": {
              "budget_reservation_mode": {
                "const": "subscription-quota"
              },
              "max_daily_spend_usd": {
                "const": 0
              },
              "max_estimated_attempt_spend_usd": {
                "const": 0
              },
              "max_estimated_pilot_spend_usd": {
                "const": 0
              }
            },
            "required": [
              "budget_reservation_mode"
            ]
          },
          "provider": {
            "properties": {
              "max_completion_usd_per_million": {
                "const": 0
              },
              "max_prompt_usd_per_million": {
                "const": 0
              },
              "wire_api": {
                "const": "codex-cli"
              }
            }
          },
          "stage": {
            "const": "representative-campaign"
          }
        },
        "required": [
          "stage"
        ]
      }
    }
  ],
  "properties": {
    "accounting": {
      "additionalProperties": false,
      "properties": {
        "budget_reservation_mode": {
          "enum": [
            "sum-attempt-ceilings",
            "shared-pool",
            "subscription-quota"
          ]
        },
        "max_daily_spend_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_estimated_attempt_spend_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_estimated_pilot_spend_usd": {
          "minimum": 0,
          "type": "number"
        },
        "max_response_requests_per_attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_tokens_scope": {
          "enum": [
            "whole-session",
            "per-continuation"
          ]
        },
        "max_transport_attempts_per_response": {
          "minimum": 1,
          "type": "integer"
        },
        "spend_basis": {
          "enum": [
            "price-ceilings",
            "provider-reported"
          ]
        }
      },
      "required": [
        "max_daily_spend_usd",
        "max_estimated_attempt_spend_usd",
        "max_estimated_pilot_spend_usd",
        "max_response_requests_per_attempt"
      ],
      "type": "object"
    },
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_total_tokens",
        "max_output_tokens",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "fixture_fingerprints": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "panel_id": {
      "const": "representative-v1"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "max_completion_usd_per_million": {
          "minimum": 0,
          "type": "number"
        },
        "max_prompt_usd_per_million": {
          "minimum": 0,
          "type": "number"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "enum": [
            "openrouter",
            "codex-subscription"
          ]
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "wire_api": {
          "enum": [
            "responses",
            "codex-cli"
          ]
        }
      },
      "required": [
        "name",
        "model",
        "reasoning_effort",
        "wire_api",
        "max_prompt_usd_per_million",
        "max_completion_usd_per_million"
      ],
      "type": "object"
    },
    "resource_controls": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "const": "none"
        },
        "pids_limit": {
          "minimum": 1,
          "type": "integer"
        },
        "read_only_rootfs": {
          "const": true
        },
        "tmpfs_size_mib": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "network",
        "read_only_rootfs",
        "pids_limit",
        "tmpfs_size_mib"
      ],
      "type": "object"
    },
    "runtime_image": {
      "pattern": "^.+@sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "enum": [
        "completion",
        "representative-campaign"
      ]
    },
    "task_fingerprints": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "task_fixture_ids": {
      "additionalProperties": {
        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "treatment_protocol": {
      "additionalProperties": false,
      "properties": {
        "agent_instruction": {
          "minLength": 1,
          "type": "string"
        },
        "codira_mcp_instruction": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "version",
        "codira_mcp_instruction"
      ],
      "type": "object"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "fixture_fingerprints",
    "task_fingerprints",
    "task_fixture_ids",
    "budgets",
    "provider",
    "accounting",
    "resource_controls",
    "visibility"
  ],
  "type": "object"
}

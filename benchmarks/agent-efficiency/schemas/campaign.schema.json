{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "max_total_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_total_tokens",
        "max_output_tokens",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "fixture_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "task_fingerprints": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "fixture_fingerprint",
    "task_fingerprints",
    "budgets",
    "visibility"
  ],
  "type": "object"
}

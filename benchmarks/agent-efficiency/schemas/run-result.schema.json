{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assistance_mode": {
      "enum": [
        "baseline",
        "codira-mcp"
      ]
    },
    "attempt_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$",
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "oracle_failure",
        "infrastructure_failure",
        "cancelled"
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "string"
        },
        "runner_version": {
          "type": "string"
        }
      },
      "required": [
        "runner",
        "runner_version"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "cached_input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_output_tokens"
      ],
      "type": "object"
    },
    "usage_complete": {
      "type": "boolean"
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "task_id",
    "attempt_id",
    "assistance_mode",
    "outcome",
    "usage_complete",
    "usage",
    "provenance"
  ],
  "type": "object"
}
